# Razor Cloud Dashboard Environment Configuration

# Razor Cloud API Base URL (Default: http://localhost:5000)
API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Cloud Management API Key (Passed via X-Cloud-Management-Key header)
MANAGEMENT_API_KEY=
NEXT_PUBLIC_MANAGEMENT_API_KEY=

# Local Development Server Port
PORT=3002
