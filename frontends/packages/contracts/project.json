{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "contracts",
  "projectType": "library",
  "sourceRoot": "frontends/packages/contracts/src",
  "tags": [
    "scope:shared",
    "profile:d",
    "lang:typescript"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @razor/contracts typecheck",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @razor/contracts build",
        "cwd": "."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @razor/contracts build",
        "cwd": "."
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm audit --audit-level high || true",
        "cwd": "."
      }
    }
  }
}
