{
  "name": "razor-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "nx": "nx",
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:backends": "node scripts/dev-all.mjs --backends",
    "dev:frontends": "node scripts/dev-all.mjs --frontends",
    "dev:dashboard": "nx dev cloud-dashboard",
    "dev:marketplace": "nx dev marketplace",
    "engine": "node scripts/run-engine.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "build:engine:all": "node scripts/build-engine.mjs --all",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:all": "node scripts/test-all.mjs",
    "test:backend": "dotnet test core/Razor.sln -c Release",
    "test:frontend": "nx run-many -t test --projects=cloud-dashboard,marketplace,contracts,api-client,ui-kit",
    "lint": "nx run-many -t lint",
    "audit": "nx run-many -t audit",
    "codegen": "nx run api-client:generate"
  },
  "devDependencies": {
    "@nx/devkit": "^20.4.0",
    "@nx/js": "^20.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "nx": "^20.4.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
